PORT=3000
DATABASE_URL=postgres://labyrinth:labyrinth@localhost:5432/labyrinth?sslmode=disable
# Dev compose.yaml's host port for Postgres (default 5432); change DATABASE_URL to match.
# POSTGRES_PORT=5432

# Ed25519 key that signs JWTs. Generate a pair with: go run . keygen
# (put JWT_PUBLIC_KEY in frontend/.env)
JWT_PRIVATE_KEY=

# HMAC-SHA256 secret that signs and verifies the rotating waypoint QR tokens.
# Generate with: go run . keygen. Never shared with the frontend.
QR_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI must be PUBLIC_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser reaches this backend, and where the SvelteKit app lives.
# In production, compose sets both from BACKEND_HOST and FRONTEND_HOST (below).
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Optional, comma-separated. Empty allows any verified Google account.
ALLOWED_EMAIL_DOMAINS=

# Production: this file is the development template. On the VM, deploy.sh
# writes the .env next to compose.prod.yaml from Secret Manager (one
# labyrinth-<NAME> secret per value above and below; see README.md,
# "Deploying"), plus IMAGE_TAG. There, DATABASE_URL, PORT, PUBLIC_URL and
# FRONTEND_URL are set by compose, not read from it. These are production only:

# The Postgres password, URL-safe (openssl rand -hex 24).
POSTGRES_PASSWORD=

# Caddy's hostnames (DNS A records pointing at the VM) and the email Let's
# Encrypt sends certificate notices to. FRONTEND_HOST serves the frontend (and
# /api/events), BACKEND_HOST every backend route.
FRONTEND_HOST=
BACKEND_HOST=
ACME_EMAIL=

# The image version to run, for both the backend and Caddy (not a secret).
IMAGE_TAG=
