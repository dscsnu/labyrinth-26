PORT=3000
DATABASE_URL=postgres://labyrinth:labyrinth@localhost:5432/labyrinth?sslmode=disable
# Dev compose.yaml's host port for Postgres (default 5432); change DATABASE_URL to match.
# POSTGRES_PORT=5432

# Ed25519 key that signs JWTs. Generate a pair with: go run . keygen
# (put JWT_PUBLIC_KEY in frontend/.env)
JWT_PRIVATE_KEY=

# HMAC-SHA256 secret that signs and verifies the rotating waypoint QR tokens.
# Generate with: go run . keygen. Never shared with the frontend.
QR_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI must be PUBLIC_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser reaches this backend, and where the SvelteKit app lives.
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Optional, comma-separated. Empty allows any verified Google account.
ALLOWED_EMAIL_DOMAINS=

# Production (the root compose.prod.yaml, run with --env-file backend/.env) only: the Postgres password, URL-safe
# (openssl rand -hex 24). There, DATABASE_URL and PORT above are ignored.
POSTGRES_PASSWORD=
