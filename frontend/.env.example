BACKEND_URL=http://localhost:3000
# Production only: where this server reaches the backend instead of BACKEND_URL
# (compose.prod.yaml sets http://backend:3000). Leave unset in dev.
# BACKEND_INTERNAL_URL=

# Public half of backend JWT_PRIVATE_KEY; print it with `go run . pubkey` in backend/
JWT_PUBLIC_KEY=

# Dev only: paste a labyrinth_token cookie value to be signed in without Google (e.g. on a phone)
DEV_TOKEN=

# Set to true to open /test-bosses in a build too (it's always open in dev),
# e.g. when testing over HTTPS on Tailscale. Never in production.
# TEST_PAGES=
